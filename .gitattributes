# Binary assets via Git LFS (keeps git history lean; pointers in tree).
# NOTE: free GitHub LFS = 1 GB storage/bandwidth. The mirror is ~1 GB — for a
# public repo, host the bulky rebuildables (drivers/*, large archives, mesa/*) via
# GitHub Releases instead, and keep STL/firmware/datasheets/scripts here. See assets/PROVENANCE.md.
*.stl   filter=lfs diff=lfs merge=lfs -text
*.step  filter=lfs diff=lfs merge=lfs -text
*.3mf   filter=lfs diff=lfs merge=lfs -text
*.zip   filter=lfs diff=lfs merge=lfs -text
*.7z    filter=lfs diff=lfs merge=lfs -text
*.rar   filter=lfs diff=lfs merge=lfs -text
*.gz    filter=lfs diff=lfs merge=lfs -text
*.tar   filter=lfs diff=lfs merge=lfs -text
*.xz    filter=lfs diff=lfs merge=lfs -text
